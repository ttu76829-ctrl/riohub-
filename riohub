        end
    end
end)

-- Khóa tốc độ liên tục trong RenderStepped & theo dõi biến đổi thuộc tính
RunService.RenderStepped:Connect(function()
    if speedEnabled then
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.WalkSpeed ~= customSpeed then
                hum.WalkSpeed = customSpeed
            end
        end
    end
end)

-- 2. TẠO AURA VÀ TỰ ĐỘNG SPAM PHÍM F KHÍ BÓNG LẠI GẦN
local function createAuraRing()
    if auraPart then auraPart:Destroy() end
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    auraPart = Instance.new("Part")
    auraPart.Name = "RioParryAura"
    auraPart.Shape = Enum.PartType.Cylinder
    auraPart.Size = Vector3.new(0.1, parryDistance * 2, parryDistance * 2)
    auraPart.Material = Enum.Material.Neon
    auraPart.Color = Color3.fromRGB(0, 255, 180)
    auraPart.Transparency = 0.65
    auraPart.CanCollide = false
    auraPart.Massless = true

    local root = char.HumanoidRootPart
    auraPart.CFrame = root.CFrame * CFrame.Angles(0, 0, math.rad(90))
    
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = auraPart
    weld.Parent = auraPart
    auraPart.Parent = char
end

local function removeAuraRing()
    if auraPart then
        auraPart:Destroy()
        auraPart = nil
    end
end

parryBtn.MouseButton1Click:Connect(function()
